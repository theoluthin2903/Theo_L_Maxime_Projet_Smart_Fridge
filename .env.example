# Copiez ce fichier en .env puis remplissez les valeurs. Ne partagez jamais le fichier .env.

# Base de données : sans valeur, une base SQLite locale (smartfridge.db) est utilisée.
DATABASE_URL=

# Clé de signature des jetons de connexion : 32 caractères minimum, obligatoire.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Clé de l'API USDA FoodData Central (données nutritionnelles)
USDA_API_KEY=

# Mettre 1 si le site est derrière un reverse proxy (Scalingo, Render…) : l'adresse IP
# des visiteurs est alors lue dans X-Forwarded-For pour la limite de tentatives de connexion.
TRUST_PROXY=

# Cookie de connexion « Secure » (envoyé seulement en HTTPS) : détecté automatiquement.
# Forcer avec 1 (toujours) ou 0 (jamais, uniquement pour des tests en local).
COOKIE_SECURE=
